<UserControl x:Class="MarkdownExporter.Controls.PdfMarginsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MarkdownExporter.Localization">
    <Expander x:Name="MarginExpander" Style="{StaticResource UiStyle.MarginExpander}">
        <Expander.Header>
            <StackPanel>
                <TextBlock Text="{loc:Tr PdfMargins}" FontWeight="SemiBold"
                           Foreground="{Binding Foreground, ElementName=MarginExpander}" />
                <TextBlock x:Name="SummaryText" FontSize="11" Margin="0,3,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource UiStyle.MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded, ElementName=MarginExpander}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource UiBrush.DisabledText}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Expander.Header>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                <TextBlock Text="{loc:Tr PdfMarginTop}" Margin="0,0,0,3"
                           Foreground="{Binding Foreground, ElementName=MarginExpander}" />
                <TextBox x:Name="TopText" TextChanged="MarginTextChanged" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,8">
                <TextBlock Text="{loc:Tr PdfMarginBottom}" Margin="0,0,0,3"
                           Foreground="{Binding Foreground, ElementName=MarginExpander}" />
                <TextBox x:Name="BottomText" TextChanged="MarginTextChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="{loc:Tr PdfMarginLeft}" Margin="0,0,0,3"
                           Foreground="{Binding Foreground, ElementName=MarginExpander}" />
                <TextBox x:Name="LeftText" TextChanged="MarginTextChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="{loc:Tr PdfMarginRight}" Margin="0,0,0,3"
                           Foreground="{Binding Foreground, ElementName=MarginExpander}" />
                <TextBox x:Name="RightText" TextChanged="MarginTextChanged" />
            </StackPanel>
        </Grid>
    </Expander>
</UserControl>
